@page
@model OneonOneTest.Pages.BankAccountPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit your account details</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BankAccount.Id" />
            <div class="form-group">
                <label asp-for="BankAccount.AccountNumber" class="control-label"></label>
                <input asp-for="BankAccount.AccountNumber" class="form-control" />
                <span asp-validation-for="BankAccount.AccountNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.OpeningDate" class="control-label"></label>
                <input asp-for="BankAccount.OpeningDate" class="form-control" />
                <span asp-validation-for="BankAccount.OpeningDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.CurrentBalance" class="control-label"></label>
                <input asp-for="BankAccount.CurrentBalance" class="form-control" />
                <span asp-validation-for="BankAccount.CurrentBalance" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.AccountName" class="control-label"></label>
                <input asp-for="BankAccount.AccountName" class="form-control" />
                <span asp-validation-for="BankAccount.AccountName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BankAccount.NumberofTransactions" class="control-label"></label>
                <input asp-for="BankAccount.NumberofTransactions" class="form-control" />
                <span asp-validation-for="BankAccount.NumberofTransactions" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
